extends "res://tests/support/test_case.gd"

func _run() -> void:
	var item: Dictionary = PackCatalog.item("iron_charm")
	check(not PackKeywords.list_markup(PackKeywords.item_stats(item)).contains("maximum"), "Resource additions omit maximum qualifier")
	var relic: Dictionary = PackCatalog.relic("bone_parliament")
	check(PackKeywords.relic_stats(relic).is_empty(), "Conditional relic rules are prose, not stat rows")
	var abilities = preload("res://systems/relics/relic_abilities.gd")
	check(abilities.description(relic).contains("Companion Bond"), "Repeated companion rules have a shared ability")
	check(PackKeywordLinks.rich(abilities.description(relic)).contains("relic_ability_companions"), "Shared ability is a hoverable keyword")
	check(not PackKeywordLinks.entry("relic_ability_companions").is_empty(), "Ability keyword has its own definition")
	var layout = load("res://scenes/run/character/player/player.tscn").instantiate()
	root.add_child(layout)
	layout.set_process(false)
	var mana: PixelStatBar = layout.get_node("ManaBar")
	mana.set_amount(1, 1)
	layout._layout_resources()
	layout._process(0.4)
	var initial: float = mana.size.x
	mana.set_amount(4, 4)
	layout._layout_resources()
	check_equal(mana.size.x, initial, "Capacity change starts at existing width")
	layout._process(0.2)
	check(mana.size.x > initial and mana.size.x < mana.resource_width(), "Capacity grows smoothly midway")
	layout._process(0.2)
	check(is_equal_approx(mana.size.x, mana.resource_width()), "Capacity reaches target in 0.4 seconds")
	mana.set_amount(2, 2)
	layout._layout_resources()
	layout._process(0.2)
	var interrupted: float = mana.size.x
	mana.set_amount(3, 3)
	layout._layout_resources()
	check(is_equal_approx(mana.size.x, interrupted), "Interrupted capacity transition preserves current width")
	layout._process(0.4)
	check(is_equal_approx(mana.size.x, mana.resource_width()), "Interrupted transition settles at newest maximum")
	var board := BackpackBoard.new()
	root.add_child(board)
	board.run = PackRun.new()
	board.run.reset(42)
	board.run.items.clear()
	board.run.add_item("rusty_knife", Vector2i.ZERO)
	board.reward_craft_item = PackCatalog.item("rusty_knife")
	board.reward_craft_item["id"] = -100
	var trigger := Control.new()
	trigger.position = Vector2(20, 300)
	trigger.size = Vector2(100, 60)
	root.add_child(trigger)
	board.reward_craft_trigger = trigger
	var craft = preload("res://scenes/run/inventory/backpack/crafting_presentation.gd")
	var partners: Array[Dictionary] = PackRun.CRAFTING.partners(board.run, board.reward_craft_item)
	check(partners.size() == 1, "Reward recognizes packed crafting partner without adding reward to inventory")
	var points: Array[Vector2] = craft._pair_points(board, board.reward_craft_item, partners[0])
	check(points.size() == 2 and points[0] == trigger.get_global_rect().get_center(), "Reward crafting link starts at choice trigger")
	check(craft._find_item(board, -100) == board.reward_craft_item, "Reward link remains resolvable while fading")
	var inspector := PackInspector.new()
	root.add_child(inspector)
	inspector.set_process(false)
	inspector.register(trigger, func() -> Dictionary: return {})
	inspector.source = trigger
	inspector.source_rect = trigger.get_global_rect()
	inspector._spawn({"key": "moving", "title": "Moving", "moving_trigger": true}, inspector.source_rect, -1)
	await process_frame
	await process_frame
	trigger.position += Vector2(200, 0)
	trigger.size += Vector2(1, 0)
	inspector.pointer = trigger.get_global_rect().get_center()
	check(inspector._trigger_held(0, -1), "Moving trigger uses current bounds without mouse motion")
	check(not inspector._reflow_requested, "Animated bounds do not continuously reposition tooltip or suspend timers")
	inspector._process(inspector.lock_delay)
	check(inspector.windows[0].locked, "Moving trigger still completes tooltip lock")
	inspector.pointer = inspector.source_rect.get_center()
	check(not inspector._trigger_held(0, -1), "Old animated bounds no longer hold tooltip open")
	inspector._process(inspector.grace_delay + 0.01)
	check(inspector.windows.is_empty(), "Moving away expires tooltip grace normally")
	inspector.clear()
	inspector.queue_free()
	board.queue_free()
	trigger.queue_free()
	layout.queue_free()
	await process_frame
	report("TOOLTIP RESOURCE POLISH")
	quit(1 if failures else 0)
