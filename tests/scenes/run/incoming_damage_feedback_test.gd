extends "res://tests/support/prototype_support.gd"

func _run() -> void:
	var bar: PixelStatBar = load("res://components/ui/indicators/pixel_stat_bar/pixel_stat_bar.tscn").instantiate()
	root.add_child(bar)
	bar.set("animate_damage", true)
	bar.set_protected_amount(100, 100, 0)
	bar.set_protected_amount(60, 100, 0)
	check(bar.value == 60, "Health number updates immediately")
	check(bar.get("display_health_ratio") != null and bar.get("display_health_ratio") > 0.6, "Health fill eases toward damage")
	if bar.has_method("advance_damage"):
		bar.advance_damage(0.12)
		check(is_equal_approx(bar.display_health_ratio, 0.6), "Health fill settles quickly")
		check(bar.damage_trail_ratio == 1.0, "Lost health remains visible")
		bar.set_protected_amount(40, 100, 0)
		bar.advance_damage(0.8)
		check(bar.damage_trail_ratio == 1.0, "Repeated hits extend the damage trail")
		bar.set_glow_paused(true)
		bar.advance_damage(0.5)
		check(bar.damage_trail_ratio == 1.0, "Pause freezes the trail")
		bar.set_glow_paused(false)
		bar.advance_damage(0.5)
		check(is_equal_approx(bar.damage_trail_ratio, 0.4), "Trail expires after its hold and fade")
		bar.set_protected_amount(70, 100, 0)
		check(bar.display_health_ratio == 0.7 and bar.damage_trail_ratio == 0.7, "Healing clears stale damage")
		bar.set_protected_amount(60, 100, 0)
		bar.set_protected_amount(20, 20, 0)
		check(bar.display_health_ratio == 1.0 and bar.damage_trail_ratio == 1.0, "New capacity resets feedback")
	var overlay: Control = Control.new()
	overlay.set_script(load("res://systems/combat/feedback/combat_popup_overlay.gd"))
	root.add_child(overlay)
	overlay.size = Vector2(1280, 720)
	check(overlay.has_method("show_player_hit"), "Incoming damage has its own popup entry point")
	if overlay.has_method("show_player_hit"):
		overlay.show_player_hit({"taken": 12, "blocked": 8}, "physical")
		check(overlay.effect_popups.size() == 2, "Health damage and absorbed shield remain distinct")
		check(overlay.effect_popups[0].anchor.x < 640, "Incoming feedback stays on the left")
		check(overlay.effect_popups[0].anchor.distance_to(overlay.effect_popups[1].anchor) >= 100, "Incoming numbers have separated origins")
		check(overlay.effect_popups[0].get("size_multiplier", 1.0) == 2.0, "Incoming numbers use larger perspective")
		var count: int = overlay.effect_popups.size()
		overlay.show_player_hit({"taken": 0, "blocked": 0}, "physical")
		check(overlay.effect_popups.size() == count, "Avoided attacks do not invent damage")
		for hit: int in range(3):
			overlay.show_player_hit({"taken": 2}, "physical", 4.0)
		check(overlay.effect_popups[-1]["elapsed"] < 0, "Rapid hits wait for a free lane instead of overlapping")
		bar.set_protected_amount(20, 20, 8)
		bar.set_protected_amount(20, 20, 0)
		check(bar.damage_trail_ratio == bar.ratio, "Shield loss does not invent lost health")
	bar.queue_free()
	overlay.queue_free()
	report("INCOMING DAMAGE")
	quit(1 if failures else 0)

