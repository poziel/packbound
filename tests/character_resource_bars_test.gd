extends SceneTree

func _initialize() -> void:
	var bar = load("res://components/pixel_stat_bar/pixel_stat_bar.tscn").instantiate()
	root.add_child(bar)
	bar.set_protected_amount(30, 40, 15)
	assert(bar.value == 30 and bar.max_value == 40)
	assert(bar.get_value_text() == "30 / 40 +15")
	assert(is_equal_approx(bar.ratio, 0.75))
	assert(bar.protection_pattern)
	bar.set_protected_amount(30, 40, 130)
	assert(is_equal_approx(bar.ratio, 0.75))
	assert(bar.get_value_text() == "30 / 40 +130")
	bar.set_protected_amount(30, 40, 0)
	assert(bar.value == 30 and not bar.protection_pattern)
	bar.segmented = true
	bar.number_mode = PixelStatBar.NumberMode.HIDDEN
	bar.set_amount(1, 1)
	assert(bar.resource_width() == bar.segment_width + bar.pixel_size * 6)
	assert(bar.get_minimum_size().x <= bar.resource_width())
	bar.set_amount(2, 4)
	assert(bar.get_value_text().is_empty())
	assert(bar.segment_rects(Rect2(0, 0, 190, 8)).size() == 4)
	assert(bar.segment_rects(Rect2(0, 0, 190, 8))[0].size.x == 12)
	bar.set_amount(2, 10)
	assert(bar.segment_rects(Rect2(0, 0, 190, 8))[0].size.x == 12)
	bar.set_amount(2, 100)
	assert(bar.segment_rects(Rect2(0, 0, 190, 8)).is_empty())
	bar.set_amount(0, 0)
	assert(bar.segment_rects(Rect2(0, 0, 190, 8)).is_empty())
	print("CHARACTER RESOURCE BARS: passed")
	quit()
