extends "res://tests/support/test_case.gd"
func _initialize() -> void:
	if not require_isolation():
		return
	_run.call_deferred()
func _run() -> void:
	var run := PackRun.new()
	run.reset(42)
	run.items.clear()
	var charm: Dictionary = run.add_item("iron_charm", Vector2i.ZERO)
	check(PackRun.CRAFTING.toggle_lock(run, charm) and charm.has("craft_lock"), "Items without recipes can be locked")
	charm["cell"] = Vector2i(5, 5)
	PackRun.CRAFTING.plans(run)
	check(charm.has("craft_lock"), "Lock persists when moved away")
	var saves := PackRunSaves.new()
	var restored := PackRun.new()
	saves.restore(restored, saves.capture(run, 0))
	check(restored.items[0].has("craft_lock"), "Item locks survive save and restore")
	run.items.clear()
	var locked: Dictionary = run.add_item("bandage", Vector2i.ZERO)
	var first: Dictionary = run.add_item("bandage", Vector2i.RIGHT)
	var second: Dictionary = run.add_item("bandage", Vector2i(2, 0))
	PackRun.CRAFTING.toggle_lock(run, locked)
	var attempts: Array = PackRun.CRAFTING.attempts(run)
	check(attempts.size() == 1 and attempts[0]["components"].has(first) and attempts[0]["components"].has(second) and not attempts[0]["components"].has(locked), "Unlocked bandages form their own craft attempt")
	run.add_item("antidote", Vector2i(2, 1))
	check(PackRun.CRAFTING.plans(run).size() == 1, "Two unlocked bandages can craft while the third is locked")
	var board: BackpackBoard = load("res://scenes/run/inventory/backpack/backpack.tscn").instantiate()
	board.run = run
	root.add_child(board)
	board.set_process(false)
	board._process(0.2)
	check(board._crafting_tooltips.is_empty(), "Loading adjacent ingredients does not open a popup")
	board.hovered_id = first["id"]
	board._process(0.1)
	var pair: Array = [first["id"], second["id"]]
	pair.sort()
	check(board._crafting_hover.has(str(pair)), "Unlocked bandages retain their connecting trail")
	board.clear_activation_feedback()
	board._process(0.2)
	check(board._crafting_tooltips.is_empty(), "Round refresh does not open a popup")
	board.begin_drag(first, board.item_rect(first).get_center())
	check(locked.has("craft_lock"), "Dragging a neighbor preserves independent locks")
	board.cancel_drag()
	run.items.clear()
	run.add_item("rusty_knife", Vector2i.ZERO)
	var moved: Dictionary = run.add_item("rusty_knife", Vector2i(3, 0))
	board.begin_drag(moved, board.item_rect(moved).get_center())
	board.drop_at(board.ORIGIN + Vector2(board.STEP + 32, 32))
	board._process(0.3)
	check(board._crafting_tooltips.size() == 1, "Placing mergeable items together opens a craft popup")
	board._process(5)
	board._process(0.1)
	check(board._crafting_tooltips.is_empty(), "Placement popup expires without reopening")
	board.queue_free()
	await process_frame
	print("CRAFT PERSISTENCE: %d failures" % failures)
	report("crafting_persistence")
	quit(1 if failures else 0)
