extends "res://tests/support/test_case.gd"

func _run() -> void:
	var script = load("res://systems/development/dev_commands.gd") if FileAccess.file_exists("res://systems/development/dev_commands.gd") else null
	check(script != null, "Developer command authority exists")
	if script == null:
		report("DEV COMMANDS")
		quit(1)
		return
	var service = script.new()
	var run := PackRun.new()
	run.reset(1729)
	var before: int = run.items.size()
	check(not service.apply(run, "grant_item", {"key": "invalid", "quantity": 1}).ok, "Unknown item rejected")
	check_equal(run.items.size(), before, "Invalid grant leaves inventory unchanged")
	check(service.apply(run, "grant_item", {"key": "rusty_knife", "quantity": 2}).ok, "Grant two catalog items")
	check_equal(run.items.size(), before + 2, "Two items added")
	check(run.items[-1].cell == null and run.items[-2].cell == null, "Granted items default to storage")
	check(run.items[-1].id != run.items[-2].id, "Granted instances have unique IDs")
	check(not service.apply(run, "grant_item", {"key": "rusty_knife", "quantity": 0}).ok, "Zero quantity rejected")
	check(service.apply(run, "add_relic", {"key": "echo_clock"}).ok, "Add relic")
	check(not service.apply(run, "add_relic", {"key": "echo_clock"}).ok, "Duplicate relic rejected")
	var inventory: Array = run.items.duplicate(true)
	var reward_count: int = run.item_rewards.size()
	check(service.apply(run, "defeat_enemy").ok, "Instant defeat succeeds")
	check_equal(run.item_rewards.size(), reward_count + 1, "Instant defeat grants reward once")
	check(not service.apply(run, "defeat_enemy").ok, "Repeated defeat rejected")
	check_equal(run.item_rewards.size(), reward_count + 1, "No duplicate reward")
	check(not service.apply(run, "travel", {"floor": 0, "kind": "combat"}).ok, "Floor zero rejected")
	check(not service.apply(run, "travel", {"floor": 21, "kind": "combat"}).ok, "Floor 21 rejected")
	for kind: String in ["combat", "rest", "relic", "encounter", "selector"]:
		check(service.apply(run, "travel", {"floor": 12, "kind": kind}).ok, "Travel to " + kind)
		check_equal(run.display_floor(), 12, "Destination floor is correct")
		check_equal(run.items, inventory, "Travel preserves inventory")
		check_equal(run.item_rewards.size(), reward_count + 1, "Travel preserves earned rewards")
	check(not service.apply(run, "set_player", {"stat": "hp", "value": -1}).ok, "Negative health rejected")
	check(service.apply(run, "set_player", {"stat": "hp", "value": 8}).ok, "Set health")
	check_equal(run.hp, 8, "Health changed")
	service.apply(run, "travel", {"floor": 1, "kind": "combat"})
	run.start_combat()
	run.begin_turn()
	check(not service.apply(run, "set_player", {"stat": "hp", "value": 10}).ok, "Pending response blocks direct edits")
	run.reset(1729, "ranger")
	check(not service.apply(run, "remove_item", {"id": run.quiver().id}).ok, "Permanent quiver cannot be removed")
	check(service.apply(run, "quiver_upgrade", {"key": "arrow_bodkin"}).ok, "Quiver arrow choice supported")
	check_equal(run.quiver().arrow_type, "bodkin", "Arrow type applied")
	check(run.item_rewards.is_empty(), "Developer starting-arrow choice consumes the normal initial choice")
	run.quiver().upgrades["quiver_capacity"] = 2
	run.item_rewards.append({"floor": 2, "offers": ["quiver_capacity", "blood_gem"]})
	run.offers.assign(run.item_rewards[0].offers)
	check(service.apply(run, "quiver_upgrade", {"key": "quiver_capacity"}).ok, "Developer upgrade uses normal cap")
	check(not run.item_rewards[0].offers.has("quiver_capacity"), "Capped developer upgrade removes invalid pending reward choice")
	check(not service.apply(run, "quiver_upgrade", {"key": "quiver_capacity"}).ok, "Capped upgrade rejected without mutation")
	var enemy_keys: Array = service.catalog("enemies").map(func(entry: Dictionary) -> String: return entry.key)
	for profile: Dictionary in preload("res://systems/enemies/enemy_expansion.gd").profiles():
		check(enemy_keys.has(profile.key), "Enemy catalog includes " + profile.key)
	run.phase = PackRun.Phase.DEFEAT
	var defeated_count: int = run.items.size()
	check(not service.apply(run, "grant_item", {"key": "rusty_knife", "quantity": 2}).ok, "Defeated run cannot falsely report an item grant")
	check_equal(run.items.size(), defeated_count, "Defeated grant leaves inventory unchanged")
	run.reset(1729)
	for item: Dictionary in run.items: item.cell = null
	for y in range(PackRun.GRID.y):
		for x in range(PackRun.GRID.x): run.add_item("rusty_knife", Vector2i(x, y))
	check(service.apply(run, "grant_item", {"key": "rusty_knife", "quantity": 1, "auto_place": true}).ok, "Full backpack grant succeeds into stash")
	check(run.items[-1].cell == null, "Failed auto-place retains item in stash")
	run.reset(1729)
	service.apply(run, "set_player", {"stat": "block", "value": 25})
	check_equal(run.starting_resources()[GameplayTypes.Stat.BLOCK], 25, "Block edit defines the next fight starting budget")
	run.start_combat()
	check_equal(run.block, 25, "Starting combat preserves the explicitly edited Block budget")
	run.reset(1729, "necromancer")
	check(service.apply(run, "defeat_enemy").ok, "Necromancer instant kill succeeds")
	check_equal(run.undead_companions, 2, "Instant kill raises one companion")
	service.apply(run, "defeat_enemy")
	check_equal(run.undead_companions, 2, "Repeated instant kill does not raise another companion")
	report("DEV COMMANDS")
	quit(1 if failures else 0)
