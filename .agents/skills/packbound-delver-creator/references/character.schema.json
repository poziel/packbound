              "amount",
              "scalingStat",
              "scalingMultiplier",
              "target",
              "damageType",
              "bypassesShield",
              "durationRounds"
            ],
            "properties": {
              "stat": {
                "type": "string"
              },
              "amount": {
                "type": "integer"
              },
