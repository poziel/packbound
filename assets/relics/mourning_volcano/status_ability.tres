[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://systems/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" path="res://systems/abilities/effect_definition.gd" id="effect"]
[ext_resource type="Resource" path="res://assets/relics/mourning_volcano/apply_burn.tres" id="e0"]
[ext_resource type="Script" path="res://systems/abilities/condition_definition.gd" id="condition"]
[ext_resource type="Script" path="res://systems/abilities/combat_metric_condition_definition.gd" id="metric_condition"]

[sub_resource type="Resource" id="condition"]
script = ExtResource("metric_condition")
metric = 0
comparison = 1
threshold = 50

[resource]
resource_name = "Mourning Volcano: Status grants"
script = ExtResource("ability")
id = &"mourning_volcano_status_grants"
display_name = "Mourning Volcano: Status grants"
trigger_id = &"relic_stats"
conditions = Array[ExtResource("condition")]([SubResource("condition")])
effects = Array[ExtResource("effect")]([ExtResource("e0")])
