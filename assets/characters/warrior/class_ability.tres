[resource]
resource_name = "Momentum"
script = ExtResource("4_15cws")
id = &"warrior_class_rules"
display_name = "Momentum"
description = "Start each fight with 0 Momentum. Gain 1 after each completed exchange with the enemy. Specialized equipment builds Momentum or spends it on powerful strikes. Momentum resets for the next fight."
