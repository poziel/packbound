[resource]
resource_name = "Venom Codex rules"
script = ExtResource("4_jo4qf")
id = &"venom_orb_rules"
display_name = "Venom Codex rules"
description = "A venom spell that deals 3 magical damage and applies 2 poison for 2 mana and no stamina. It activates each round when both resource costs can be paid, in priority and backpack reading order. Echo repeats its damage, condition and elemental trace contribution. Magical resistance reduces its damage; block absorbs direct damage after resistance. Conditions bypass block."
