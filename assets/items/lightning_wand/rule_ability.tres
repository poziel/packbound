[resource]
resource_name = "Storm Wand rules"
script = ExtResource("4_yn1fx")
id = &"lightning_wand_rules"
display_name = "Storm Wand rules"
description = "A lightning spell that deals 4 magical damage and applies 1 spark for 2 mana and no stamina. It activates each round when both resource costs can be paid, in priority and backpack reading order. Echo repeats its damage, condition and elemental trace contribution. Magical resistance reduces its damage; block absorbs direct damage after resistance. Conditions bypass block."
trigger_id = &"coded_catalog_rule"
effects = Array[ExtResource("2_lgdp4")]([ExtResource("3_jkron")])
