[resource]
resource_name = "Void Grimoire rules"
script = ExtResource("4_vhrvj")
id = &"void_tome_rules"
display_name = "Void Grimoire rules"
description = "A void spell that deals 6 magical damage and applies 1 doom for 3 mana and no stamina. It activates each round when both resource costs can be paid, in priority and backpack reading order. Echo repeats its damage, condition and elemental trace contribution. Magical resistance reduces its damage; block absorbs direct damage after resistance. Conditions bypass block."
