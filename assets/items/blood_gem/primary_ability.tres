[gd_resource type="Resource" script_class="AbilityDefinition" format=3]

[ext_resource type="Script" path="res://systems/abilities/ability_definition.gd" id="ability"]
[ext_resource type="Script" path="res://systems/abilities/effect_definition.gd" id="effect"]
[ext_resource type="Resource" path="res://assets/items/blood_gem/primary_effect.tres" id="bonus"]
[ext_resource type="Script" path="res://systems/abilities/condition_definition.gd" id="condition"]
[ext_resource type="Script" path="res://systems/abilities/collectible_target_condition_definition.gd" id="target"]

[sub_resource type="Resource" id="recipient"]
script = ExtResource("target")
category_ids = Array[StringName]([&"melee_weapons", &"ranged_weapons", &"magic_weapons", &"quivers", &"companions"])
item_ids = Array[StringName]([])

[resource]
resource_name = "Blood Gem: Primary bonus"
script = ExtResource("ability")
id = &"blood_gem_primary_bonus"
display_name = "Blood Gem: Primary bonus"
trigger_id = &"item_adjacency"
conditions = Array[ExtResource("condition")]([SubResource("recipient")])
effects = Array[ExtResource("effect")]([ExtResource("bonus")])
