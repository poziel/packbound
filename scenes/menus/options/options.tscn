[node name="ResetButton" parent="Layout/Content/FooterMargin/Footer" instance=ExtResource("hold_button")]
unique_name_in_owner = true
layout_mode = 2
theme = ExtResource("menu_theme")
theme_type_variation = &"DangerRightMenuButton"
theme_override_fonts/font = ExtResource("menu_body")
theme_override_font_sizes/font_size = 24
text = "RESET TO DEFAULT"
custom_minimum_size = Vector2(280, 56)
accessibility_name = "Reset all options to defaults"
click_description = "Reset all options and keybindings to defaults."
tooltip_text = "Hold for 1.2 seconds, then release to reset all options and keybindings. Release early to cancel."
accessibility_description = "Hold the primary mouse button or accept key for 1.2 seconds, then release to reset all options and keybindings. Release early to cancel."


[node name="SurfaceTheme" type="Node" parent="."]
script = ExtResource("surface_theme")
reference_padding = 22
background_nodes = Array[NodePath]([NodePath("Background")])
tab_nodes = Array[NodePath]([NodePath("Layout/Content/Tabs")])
