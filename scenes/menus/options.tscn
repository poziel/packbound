[gd_scene format=3]

[ext_resource type="Theme" path="res://themes/gameplay/theme.tres" id="gameplay_theme"]
[ext_resource type="Theme" path="res://themes/menu/theme.tres" id="menu_theme"]
[ext_resource type="PackedScene" path="res://components/menu_button/hold_menu_button.tscn" id="hold_button"]
[ext_resource type="FontFile" path="res://assets/fonts/ui_pixel.tres" id="menu_body"]
[ext_resource type="Script" path="res://components/pixel_tab_style.gd" id="pixel_tab_style"]
[ext_resource type="Script" path="res://components/connected_tab_container.gd" id="connected_tabs"]


[ext_resource type="Script" path="res://components/surface_theme.gd" id="surface_theme"]

[sub_resource type="StyleBoxEmpty" id="tab_panel"]
content_margin_left = 35.0
content_margin_top = 32.0
content_margin_right = 35.0
content_margin_bottom = 16.0

[sub_resource type="StyleBoxEmpty" id="tab_focus"]

[sub_resource type="StyleBox" id="tab_idle"]
resource_local_to_scene = true
script = ExtResource("pixel_tab_style")
content_margin_left = 25.0
content_margin_top = 16.0
content_margin_right = 25.0
content_margin_bottom = 16.0
bg_color = Color(0.333, 0.365, 0.424, 1)
round_top = false

[sub_resource type="StyleBox" id="tab_active"]
resource_local_to_scene = true
script = ExtResource("pixel_tab_style")
content_margin_left = 25.0
content_margin_top = 16.0
content_margin_right = 25.0
content_margin_bottom = 16.0
bg_color = Color(0.063, 0.082, 0.122, 1)
round_bottom = false
top_corner_color = Color(0.333, 0.365, 0.424, 1)

[node name="Options" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme = ExtResource("gameplay_theme")
texture_filter = 1

[node name="Background" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = 5.0
offset_top = 5.0
offset_right = -5.0
offset_bottom = -5.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.063, 0.082, 0.122, 1)

[node name="Layout" type="MarginContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/margin_left = 5
theme_override_constants/margin_top = 5
theme_override_constants/margin_right = 5
theme_override_constants/margin_bottom = 20

[node name="Content" type="VBoxContainer" parent="Layout"]
layout_mode = 2
theme_override_constants/separation = 12

[node name="Tabs" type="TabContainer" parent="Layout/Content"]
script = ExtResource("connected_tabs")
join_left_border = true
unique_name_in_owner = true
layout_mode = 2
size_flags_vertical = 3
theme_override_font_sizes/font_size = 24
theme_override_colors/font_selected_color = Color(0.94, 0.78, 0.46, 1)
theme_override_constants/side_margin = 0
theme_override_constants/tab_separation = 0
theme_override_styles/tab_focus = SubResource("tab_focus")
theme_override_colors/font_unselected_color = Color(0.025, 0.035, 0.055, 1)
theme_override_colors/font_hovered_color = Color(0.89, 0.9, 0.83, 1)
theme_override_styles/panel = SubResource("tab_panel")
theme_override_styles/tab_unselected = SubResource("tab_idle")
theme_override_styles/tab_hovered = SubResource("tab_idle")
theme_override_styles/tab_selected = SubResource("tab_active")
current_tab = 0
tab_alignment = 0


