[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/delver_tooltip.gd" id="script"]
[ext_resource type="Theme" path="res://themes/gameplay/theme.tres" id="theme"]
[ext_resource type="Texture2D" path="res://themes/menu/frames.svg" id="frames"]

[sub_resource type="StyleBoxEmpty" id="rich_empty"]

[sub_resource type="AtlasTexture" id="frame_texture"]
atlas = ExtResource("frames")
region = Rect2(0, 0, 48, 48)

[sub_resource type="StyleBoxTexture" id="frame"]
texture = SubResource("frame_texture")
texture_margin_left = 16.0
texture_margin_top = 16.0
texture_margin_right = 16.0
texture_margin_bottom = 16.0
content_margin_left = 0.0
content_margin_top = 0.0
content_margin_right = 0.0
content_margin_bottom = 0.0

[node name="DelverTooltip" type="PanelContainer"]
custom_minimum_size = Vector2(360, 0)
offset_right = 360.0
mouse_filter = 2
texture_filter = 1
theme = ExtResource("theme")
theme_override_styles/panel = SubResource("frame")
script = ExtResource("script")

[node name="Margin" type="MarginContainer" parent="."]
layout_mode = 2
mouse_filter = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 16
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 16

[node name="Content" type="VBoxContainer" parent="Margin"]
layout_mode = 2
mouse_filter = 2
theme_override_constants/separation = 8

[node name="CharacterName" type="Label" parent="Margin/Content"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.941, 0.784, 0.459, 1)
theme_override_font_sizes/font_size = 24
text = "Warrior"
autowrap_mode = 3

[node name="Stats" type="RichTextLabel" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.933333, 0.933333, 0.858824, 1)
theme_override_font_sizes/normal_font_size = 16
theme_override_constants/line_separation = 2
theme_override_styles/normal = SubResource("rich_empty")
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "40 HP / 0 mana"

[node name="Ability" type="RichTextLabel" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.941, 0.784, 0.459, 1)
theme_override_font_sizes/normal_font_size = 24
theme_override_constants/line_separation = 2
theme_override_styles/normal = SubResource("rich_empty")
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "Riposte"

[node name="Description" type="RichTextLabel" parent="Margin/Content"]
custom_minimum_size = Vector2(320, 0)
layout_mode = 2
mouse_filter = 2
theme_override_colors/default_color = Color(0.85, 0.886, 0.82, 1)
theme_override_font_sizes/normal_font_size = 16
theme_override_constants/line_separation = 2
theme_override_styles/normal = SubResource("rich_empty")
bbcode_enabled = true
fit_content = true
scroll_active = false
text = "Fully block an enemy action to counterattack for 4 + plating damage. Counterattacks ignore armor."
autowrap_mode = 3

[node name="StartingItems" type="Label" parent="Margin/Content"]
layout_mode = 2
mouse_filter = 2
theme_override_colors/font_color = Color(0.55, 0.66, 0.62, 1)
theme_override_font_sizes/font_size = 16
text = "STARTING ITEMS"

