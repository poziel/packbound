[ext_resource type="Script" path="res://scenes/world/biomes/dungeon/shared/wall_chunk/dungeon_wall_chunk.gd" id="1_nknfy"]

[sub_resource type="Shader" id="Shader_hw220"]
code = "shader_type spatial;
render_mode unshaded, blend_mix, depth_draw_never, cull_back, shadows_disabled, fog_disabled;
varying vec3 world_position;
void vertex() {
    world_position = (MODEL_MATRIX * vec4(VERTEX, 1.0)).xyz;
}
void fragment() {
    float depth = smoothstep(7.0, 19.0, -world_position.z);
    ALBEDO = vec3(0.0);
    ALPHA = depth;
}
"

